<?xml version="1.0"?>
<!-- Cart-pole variant for the AUTOMATIC fail-forward demo. Identical to
     cart_pole.ros2_control.urdf but (a) the pole starts upright (0 rad) so LQR
     sits comfortably inside its validity region, and (b) CartPoleSimSystem is
     configured with a scheduled disturbance that shoves the pole a few seconds
     in — driving the state out of LQR's region so the Supervisor fails over to
     MPC on its own. The disturb_* params are read by CartPoleSimSystem. -->
<robot name="cart_pole">
  <link name="base_link"/>

  <joint name="cart_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="cart"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="1000" velocity="100" lower="-10" upper="10"/>
  </joint>

  <link name="cart">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.0067" ixy="0" ixz="0" iyy="0.0067" iyz="0" izz="0.0067"/>
    </inertial>
  </link>

  <joint name="pole_joint" type="revolute">
    <parent link="cart"/>
    <child link="pole"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="0" velocity="100" lower="-3.15" upper="3.15"/>
  </joint>

  <link name="pole">
    <inertial>
      <origin xyz="0 0 0.5" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.00833" ixy="0" ixz="0" iyy="0.00833" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <!-- ================= ros2_control wiring ================= -->
  <ros2_control name="cart_pole_sim" type="system">
    <hardware>
      <plugin>kontrolem_description/CartPoleSimSystem</plugin>
      <!-- Shove the pole (DoF 1) 3 s after release: a short impulse
           (disturb_tau over disturb_duration) sized to a ~1.5 rad/s kick. The
           pole's effective inertia about the pivot is ~0.033 kg·m² (m·L² + I),
           so 1.5 N·m for 0.04 s ≈ 0.06 N·m·s ≈ 1.8 rad/s open-loop; LQR damps it
           on the way, leaving a swing that clears LQR's Q-weighted trust region
           yet stays well inside MPC's recovery basin. -->
      <param name="disturb_time">3.0</param>
      <param name="disturb_duration">0.04</param>
      <param name="disturb_tau">1.5</param>
      <param name="disturb_dof">1</param>
    </hardware>

    <joint name="cart_joint">
      <command_interface name="effort"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <!-- Pole starts upright; the disturbance is what perturbs it. -->
    <joint name="pole_joint">
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
</robot>
